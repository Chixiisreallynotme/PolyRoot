{
  "name": "polyroot",
  "version": "1.0.0",
  "description": "PolyRoot : Escape from PS1 — Top-down 3D survivor PS1 15-bit",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint:boundaries": "depcruise src/packages --config .dependency-cruiser.cjs",
    "check": "tsc --noEmit && npm run lint:boundaries && vitest run",
    "electron": "electron .",
    "electron:dev": "vite",
    "build:electron": "vite build && electron-builder --win --linux",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux"
  },
  "keywords": [
    "threejs",
    "ps1",
    "survivor",
    "vite",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "three": "^0.184.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.55.0",
    "@types/howler": "^2.2.12",
    "@types/three": "^0.177.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "meshoptimizer": "^1.2.0",
    "three-mesh-bvh": "^0.9.14",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-glsl": "^1.3.0",
    "vite-plugin-static-copy": "^2.3.1",
    "vitest": "^3.2.4"
  }
}
